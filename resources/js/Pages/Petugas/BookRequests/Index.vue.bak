<template>
  <div class="flex min-h-screen bg-[#F8FAFC] font-sans text-slate-900">
    <PetugasSidebar class="fixed inset-y-0 left-0 w-80 z-50 shadow-xl shadow-slate-200/50" />

    <main class="flex-1 ml-80 min-h-screen relative">
      <header class="sticky top-0 z-40 bg-white/70 backdrop-blur-md border-b border-slate-200 px-10 py-6">
        <div class="flex items-center justify-between max-w-[1400px] mx-auto">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-800">Permintaan Buku Baru</h1>
            <p class="text-slate-500 text-sm mt-1">Daftar usulan judul buku dari anggota perpustakaan</p>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex bg-slate-100 p-1 rounded-xl">
              <button @click="filterStatus = 'all'" :class="filterStatus === 'all' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500'" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all">Semua</button>
              <button @click="filterStatus = 'pending'" :class="filterStatus === 'pending' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500'" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all">Menunggu</button>
            </div>
          </div>
        </div>
      </header>

      <div class="p-10 max-w-[1400px] mx-auto space-y-8">
        <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-slate-50/50 border-b border-slate-200">
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Anggota</th>
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Detail Buku</th>
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Alasan Pengajuan</th>
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Status</th>
                  <th class="px-8 py-6 text-right text-[10px] font-black text-slate-400 uppercase tracking-widest">Tindakan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr v-for="request in filteredRequests" :key="request.id" class="hover:bg-slate-50 transition-colors group">
                  <td class="px-8 py-6">
                    <div class="flex items-center gap-4">
                      <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-xs group-hover:bg-indigo-600 group-hover:text-white transition-all">
                        {{ request.user_name?.[0]?.toUpperCase() }}
                      </div>
                      <div>
                        <p class="text-sm font-bold text-slate-800">{{ request.user_name }}</p>
                        <p class="text-[11px] text-slate-400 font-medium">{{ formatDate(request.created_at) }}</p>
                      </div>
                    </div>
                  </td>
                  <td class="px-8 py-6">
                    <p class="text-sm font-bold text-slate-700 leading-snug">{{ request.title }}</p>
                    <p class="text-[11px] font-black text-indigo-500 uppercase tracking-wider mt-0.5">{{ request.author }}</p>
                  </td>
                  <td class="px-8 py-6">
                    <div class="max-w-xs">
                      <p class="text-xs text-slate-600 italic line-clamp-2 leading-relaxed">"{{ request.reason }}"</p>
                    </div>
                  </td>
                  <td class="px-8 py-6">
                    <span :class="{
                      'bg-amber-100 text-amber-700': request.status === 'pending',
                      'bg-emerald-100 text-emerald-700': request.status === 'approved',
                      'bg-rose-100 text-rose-700': request.status === 'rejected'
                    }" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-wider inline-block">
                      {{ formatStatus(request.status) }}
                    </span>
                  </td>
                  <td class="px-8 py-6 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <button v-if="request.status === 'pending'" class="px-3 py-1 text-[10px] font-bold rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition-all">
                        Setujui
                      </button>
                      <button v-if="request.status === 'pending'" class="px-3 py-1 text-[10px] font-bold rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 transition-all">
                        Tolak
                      </button>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</template>

<script setup>
import PetugasSidebar from '@/Components/PetugasSidebar.vue';
import { ref, computed } from 'vue';

defineProps({
  bookRequests: { type: Array, default: () => [] },
});

const filterStatus = ref('all');

const filteredRequests = computed(() => {
  return bookRequests.filter(req => filterStatus.value === 'all' || req.status === filterStatus.value);
});

const formatDate = (date) => {
  return new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
};

const formatStatus = (status) => {
  const statuses = { 'pending': 'Menunggu', 'approved': 'Disetujui', 'rejected': 'Ditolak' };
  return statuses[status] || status;
};
</script>
