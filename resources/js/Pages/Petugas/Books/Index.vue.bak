<template>
  <div class="flex min-h-screen bg-[#F8FAFC] font-sans text-slate-900">
    <PetugasSidebar class="fixed inset-y-0 left-0 w-80 z-50 shadow-xl shadow-slate-200/50" />

    <main class="flex-1 ml-80 min-h-screen relative">
      <header class="sticky top-0 z-40 bg-white/70 backdrop-blur-md border-b border-slate-200 px-10 py-6">
        <div class="flex items-center justify-between max-w-[1400px] mx-auto">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-800">Manajemen Koleksi Buku</h1>
            <p class="text-slate-500 text-sm mt-1">Kelola katalog perpustakaan dengan mudah</p>
          </div>
          <Link :href="route('petugas.books.create')" class="px-6 py-2.5 bg-indigo-600 text-white rounded-xl font-bold text-sm hover:bg-indigo-700 transition-colors shadow-md shadow-indigo-200">
            + Tambah Koleksi
          </Link>
        </div>
      </header>

      <div class="p-10 max-w-[1400px] mx-auto space-y-8">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 flex items-center gap-4">
          <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </span>
            <input v-model="searchQuery" type="text" placeholder="Cari judul atau ISBN..." class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border-none rounded-xl focus:ring-2 focus:ring-slate-200 transition-all text-sm">
          </div>
          <select v-model="selectedCategory" class="bg-slate-50 border-none rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 focus:ring-2 focus:ring-slate-200 transition-all">
            <option value="">Semua Kategori</option>
            <option value="fiksi">Fiksi</option>
            <option value="nonfiksi">Non-Fiksi</option>
            <option value="referensi">Referensi</option>
            <option value="cerita">Cerita Anak</option>
          </select>
        </div>

        <div class="flex gap-2 bg-white p-2 rounded-2xl border border-slate-200 shadow-sm">
          <button @click="activeTab = 'available'" :class="activeTab === 'available' ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-50'" class="flex-1 px-4 py-2.5 rounded-xl font-bold text-sm transition-all">
            Katalog Tersedia ({{ availableBooks.length }})
          </button>
          <button @click="activeTab = 'pending'" :class="activeTab === 'pending' ? 'bg-amber-600 text-white' : 'text-slate-600 hover:bg-slate-50'" class="flex-1 px-4 py-2.5 rounded-xl font-bold text-sm transition-all">
            Menunggu Approval ({{ pendingBooks.length }})
          </button>
        </div>

        <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-slate-50/50 border-b border-slate-200">
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Judul & Penulis</th>
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">ISBN</th>
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Ketersediaan</th>
                  <th class="px-8 py-6 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Kategori</th>
                  <th class="px-8 py-6 text-right text-[10px] font-black text-slate-400 uppercase tracking-widest">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr v-for="book in displayedBooks" :key="book.id" class="hover:bg-slate-50 transition-colors group">
                  <td class="px-8 py-6">
                    <div>
                      <p class="text-sm font-bold text-slate-800">{{ book.title }}</p>
                      <p class="text-xs text-slate-500 mt-0.5">{{ book.author }}</p>
                    </div>
                  </td>
                  <td class="px-8 py-6">
                    <p class="text-xs font-bold text-indigo-600 uppercase tracking-wider font-mono">{{ book.isbn }}</p>
                  </td>
                  <td class="px-8 py-6">
                    <div class="space-y-2">
                      <div class="flex items-center gap-2">
                        <p class="text-xs font-bold text-slate-600">{{ book.available }}/{{ book.total }}</p>
                      </div>
                      <div class="w-24 h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500" :style="{ width: (book.available / book.total * 100) + '%' }"></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-8 py-6">
                    <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-lg text-[10px] font-bold uppercase tracking-wider">
                      {{ book.category }}
                    </span>
                  </td>
                  <td class="px-8 py-6 text-right">
                    <Link :href="route('petugas.books.edit', book.id)" class="px-3 py-1 text-[10px] font-bold rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition-all inline-block">
                      Edit
                    </Link>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</template>

<script setup>
import PetugasSidebar from '@/Components/PetugasSidebar.vue';
import { Link } from '@inertiajs/vue3';
import { ref, computed } from 'vue';

defineProps({
  books: { type: Array, default: () => [] },
});

const searchQuery = ref('');
const selectedCategory = ref('');
const activeTab = ref('available');

const availableBooks = computed(() => books.filter(b => b.status === 'active'));
const pendingBooks = computed(() => books.filter(b => b.status === 'pending'));

const displayedBooks = computed(() => {
  const sourceBooks = activeTab.value === 'available' ? availableBooks.value : pendingBooks.value;
  return sourceBooks.filter(book => {
    const matchesSearch = !searchQuery.value || 
      book.title.toLowerCase().includes(searchQuery.value.toLowerCase()) ||
      book.isbn.toLowerCase().includes(searchQuery.value.toLowerCase());
    const matchesCategory = !selectedCategory.value || book.category === selectedCategory.value;
    return matchesSearch && matchesCategory;
  });
});
</script>
