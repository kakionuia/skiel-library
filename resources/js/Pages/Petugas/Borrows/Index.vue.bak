      </div>
    </main>
  </div>
</template>

<script setup>
import PetugasSidebar from '@/Components/PetugasSidebar.vue';
import { ref } from 'vue';

defineProps({
  stats: { type: Object, default: () => ({ activeCount: 0, overdueCount: 0, avgDuration: 0, totalBorrowers: 0 }) },
  borrows: { type: Array, default: () => [] },
});

const searchQuery = ref('');
const selectedStatus = ref('');
const formattedDate = ref('');

const formatDate = (date) => {
  return new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
};

const formatStatus = (status) => {
  const statuses = { 'active': 'Aktif', 'returned': 'Kembali', 'overdue': 'Terlambat' };
  return statuses[status] || status;
};

const now = new Date();
formattedDate.value = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
</script>
