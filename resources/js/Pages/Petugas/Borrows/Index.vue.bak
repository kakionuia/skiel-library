            </span>
            <input v-model="searchQuery" type="text" placeholder="Cari peminjam atau judul buku..." class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border-none rounded-xl focus:ring-2 focus:ring-slate-200 transition-all text-sm">
          </div>
          <select v-model="selectedStatus" class="bg-slate-50 border-none rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 focus:ring-2 focus:ring-slate-200 transition-all">
            <option value="">Semua Status</option>
            <option value="active">Aktif</option>
            <option value="returned">Kembali</option>
            <option value="overdue">Terlambat</option>
          </select>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden">
          <table class="w-full">
            <thead>
              <tr class="bg-slate-50/50 border-b border-slate-200">
                <th class="px-8 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Peminjam</th>
                <th class="px-8 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Buku</th>
                <th class="px-8 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Tanggal Pinjam</th>
                <th class="px-8 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Jatuh Tempo</th>
                <th class="px-8 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Status</th>
                <th class="px-8 py-4 text-right text-[10px] font-black text-slate-400 uppercase tracking-widest">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr v-for="borrow in borrows" :key="borrow.id" class="hover:bg-slate-50 transition-colors">
                <td class="px-8 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-indigo-100 rounded-xl flex items-center justify-center text-sm font-bold text-indigo-600">
                      {{ borrow.member_name?.[0]?.toUpperCase() }}
                    </div>
                    <div>
                      <p class="text-sm font-bold text-slate-800">{{ borrow.member_name }}</p>
                      <p class="text-[11px] text-slate-400">{{ borrow.member_id }}</p>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-4">
                  <div>
                    <p class="text-sm font-semibold text-slate-800">{{ borrow.book_title }}</p>
                    <p class="text-[11px] text-slate-500">{{ borrow.book_isbn }}</p>
                  </div>
                </td>
                <td class="px-8 py-4 text-sm text-slate-700">{{ formatDate(borrow.borrowed_date) }}</td>
                <td class="px-8 py-4 text-sm text-slate-700">{{ formatDate(borrow.due_date) }}</td>
                <td class="px-8 py-4">
                  <span :class="{
                    'bg-emerald-100 text-emerald-700': borrow.status === 'active',
                    'bg-slate-100 text-slate-700': borrow.status === 'returned',
                    'bg-orange-100 text-orange-700': borrow.status === 'overdue'
                  }" class="px-3 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wide">
                    {{ formatStatus(borrow.status) }}
                  </span>
                </td>
                <td class="px-8 py-4 text-right">
                  <button v-if="borrow.status === 'active'" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Proses Kembali</button>
                </td>
              </tr>
            </tbody>
          </table>
